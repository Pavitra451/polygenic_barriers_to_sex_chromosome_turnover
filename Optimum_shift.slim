		avg_shutdown_X_muts_value_female = sum_shutdown_X_muts_value_female/(1.5*N);
		avg_PAR_X_muts_value_female = sum_PAR_X_muts_value_female/(1.5*N);
		
		avg_shutdown_X_muts_value_male = sum_shutdown_X_muts_value_male/(1.5*N);
		avg_PAR_X_muts_value_male = sum_PAR_X_muts_value_male/(1.5*N);
		
		avg_female_phenotype = sum_female_phenotype/(0.5*N);
		avg_male_phenotype = sum_male_phenotype/(0.5*N);
		
		output_chrom = ""+sim.cycle+
			","+avg_female_phenotype+","+avg_male_phenotype+
			","+avg_muts_auto_2_value_female+","+avg_muts_auto_2_value_male+
			","+avg_muts_auto_3_value_female+","+avg_muts_auto_3_value_male+
			","+avg_muts_auto_4_value_female+","+avg_muts_auto_4_value_male+
			","+avg_muts_auto_5_value_female+","+avg_muts_auto_5_value_male+
			","+avg_muts_auto_6_value_female+","+avg_muts_auto_6_value_male+
			","+avg_muts_auto_7_value_female+","+avg_muts_auto_7_value_male+
			","+avg_muts_auto_8_value_female+","+avg_muts_auto_8_value_male+
			","+avg_muts_auto_9_value_female+","+avg_muts_auto_9_value_male+
			","+avg_muts_auto_10_value_female+","+avg_muts_auto_10_value_male+
			","+avg_shutdown_X_muts_value_female+","+avg_shutdown_X_muts_value_male+
			","+avg_PAR_X_muts_value_female+","+avg_PAR_X_muts_value_male+
			","+avg_shutdown_Y_muts_value_female+","+avg_shutdown_Y_muts_value_male+
			","+avg_PAR_Y_muts_value_female+","+avg_PAR_Y_muts_value_male;
		
		
		
		
		writeFile(chrom_file, output_chrom, append=T);

	}

}


